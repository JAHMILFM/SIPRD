# ===================================================================
# SIPRD — Variables de Entorno y Conexión PostgreSQL (siprd_db)
# ===================================================================

# Cadena de conexión principal (PostgreSQL 16+ con asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/siprd_grupo

# Parámetros desglosados de PostgreSQL (opcional si defines DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=siprd_grupo

# Seguridad JWT
JWT_SECRET=siprd-secret-key-super-secure-production-ready-2026-alfa-distribuidores
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs de microservicios y frontend
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
MOTOR_URL=http://127.0.0.1:8001
